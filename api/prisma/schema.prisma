generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String?
  firstName               String
  lastName                String
  phone                   String?
  address                 String?
  avatarUrl               String?
  googleId                String?                  @unique
  roles                   Role[]                   @default([USUARIO])
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  refreshToken            String?
  pushTokens              String[]                 @default([])
  resetPasswordToken      String?
  resetPasswordTokenExpiry DateTime?
  barberProfiles          Barber[]
  barbershopAdmins        BarbershopAdmin[]
  cancelledBookings       Booking[]                @relation("BookingCancelledBy")
  bookings                Booking[]
  notificationPreferences NotificationPreference[]
  notificationRecipients  NotificationUser[]
  sentNotifications       Notification[]           @relation("SentNotifications")
  payments                Payment[]                @relation("RegisteredBy")
  reviews                 Review[]

  @@map("users")
}

model Image {
  id               String            @id @default(uuid())
  path             String
  url              String
  name             String?
  type             ImageType
  mimeType         String?
  size             Int?
  createdAt        DateTime          @default(now())
  barberImages     BarberImage[]
  barbershopImages BarbershopImage[]

  @@map("images")
}

model BarbershopImage {
  id           String     @id @default(uuid())
  barbershopId String
  imageId      String
  createdAt    DateTime   @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  image        Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, imageId])
  @@map("barbershop_images")
}

model Barbershop {
  id                   String                    @id @default(uuid())
  name                 String                    @unique
  slug                 String                    @unique @default("")
  description          String?
  address              String
  latitude             Float?
  longitude            Float?
  phone                String?
  depositAmount        Float                     @default(0)
  depositType          DepositType               @default(FIXED)
  cancellationHours    Int                       @default(12)
  minAdvanceHours      Int                       @default(1)
  maxAdvanceDays       Int                       @default(30)
  businessModel        BusinessModel             @default(GRATUITO)
  maxBarbers           Int                       @default(10)
  isActive             Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  maxBarberImages      Int                       @default(3)
  bankAccounts         BarbershopBankAccount[]
  barbers              Barber[]
  admins               BarbershopAdmin[]
  amenities            BarbershopAmenity[]
  images               BarbershopImage[]
  paymentMethods       BarbershopPaymentMethod[]
  services             BarbershopService[]
  subscription         BarbershopSubscription?
  offers               Offer[]
  platformTransactions PlatformTransaction[]
  reviews              Review[]

  @@map("barbershops")
}

model BarbershopBankAccount {
  id               String               @id @default(uuid())
  barbershopId     String
  accountType      BankAccountType
  // Datos bancarios (CBU / CVU)
  cbuCvu           String?
  alias            String?
  bankName         String?
  holderName       String?
  holderCuit       String?
  accountCategory  BankAccountCategory?
  // MercadoPago OAuth (accountType = MP_OAUTH)
  mpUserId         String?
  mpAccessToken    String?
  mpRefreshToken   String?
  mpTokenExpiresAt DateTime?
  // Estado
  isPrimary        Boolean              @default(false)
  isVerified       Boolean              @default(false)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  barbershop           Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  platformTransactions PlatformTransaction[]

  @@map("barbershop_bank_accounts")
}

model BarbershopAdmin {
  id           String     @id @default(uuid())
  userId       String
  barbershopId String
  role         Role       @default(SUB_ADMIN)
  createdAt    DateTime   @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, barbershopId])
  @@map("barbershop_admins")
}

model Barber {
  id           String          @id @default(uuid())
  barbershopId String
  userId       String?
  firstName    String
  lastName     String
  bio          String?
  phone        String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  images       BarberImage[]
  services     BarberService[]
  barbershop   Barbershop      @relation(fields: [barbershopId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])
  blockedSlots BlockedSlot[]
  bookings     Booking[]
  reviews      Review[]
  schedules    Schedule[]

  @@map("barbers")
}

model BarberImage {
  id        String   @id @default(uuid())
  barberId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  imageId   String
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  image     Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([barberId, imageId])
  @@map("barber_images")
}

model Service {
  id             String              @id @default(uuid())
  name           String
  nameNormalized String              @unique
  description    String?
  category       String?
  imageUrl       String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  barbers        BarberService[]
  barbershops    BarbershopService[]
  bookings       Booking[]

  @@map("services")
}

model BarbershopService {
  id           String     @id @default(uuid())
  barbershopId String
  serviceId    String
  price        Float
  durationMin  Int
  isActive     Boolean    @default(true)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  service      Service    @relation(fields: [serviceId], references: [id])

  @@unique([barbershopId, serviceId])
  @@map("barbershop_services")
}

model BarberService {
  id        String  @id @default(uuid())
  barberId  String
  serviceId String
  price     Float?
  barber    Barber  @relation(fields: [barberId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([barberId, serviceId])
  @@map("barber_services")
}

model Amenity {
  id          String              @id @default(uuid())
  name        String              @unique
  icon        String?
  category    String?
  isDefault   Boolean             @default(false)
  barbershops BarbershopAmenity[]

  @@map("amenities")
}

model BarbershopAmenity {
  id           String     @id @default(uuid())
  barbershopId String
  amenityId    String
  amenity      Amenity    @relation(fields: [amenityId], references: [id])
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  @@unique([barbershopId, amenityId])
  @@map("barbershop_amenities")
}

model Schedule {
  id                  String    @id @default(uuid())
  barberId            String
  dayOfWeek           DayOfWeek
  openTime            String
  closeTime           String
  slotDurationMinutes Int       @default(30)
  barber              Barber    @relation(fields: [barberId], references: [id])

  @@unique([barberId, dayOfWeek])
  @@map("schedules")
}

model BlockedSlot {
  id        String   @id @default(uuid())
  barberId  String
  date      DateTime
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())
  barber    Barber   @relation(fields: [barberId], references: [id])

  @@map("blocked_slots")
}

model Booking {
  id                   String                @id @default(uuid())
  userId               String
  barberId             String
  serviceId            String
  date                 DateTime
  startTime            String
  endTime              String
  totalPrice           Float
  depositPrice         Float                 @default(0)
  status               BookingStatus         @default(PENDIENTE)
  notes                String?
  recurringBookingId   String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  depositPaid          Boolean               @default(false)
  mpPaymentId          String?
  mpPreferenceId       String?
  cancelledById        String?
  barber               Barber                @relation(fields: [barberId], references: [id])
  cancelledBy          User?                 @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recurringBooking     RecurringBooking?     @relation(fields: [recurringBookingId], references: [id])
  service              Service               @relation(fields: [serviceId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  payments             Payment[]
  platformTransactions PlatformTransaction[]

  @@map("bookings")
}

model RecurringBooking {
  id         String             @id @default(uuid())
  userId     String
  barberId   String
  serviceId  String
  dayOfWeek  DayOfWeek
  startTime  String
  endTime    String
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  exceptions BookingException[]
  bookings   Booking[]

  @@map("recurring_bookings")
}

model BookingException {
  id                 String           @id @default(uuid())
  recurringBookingId String
  excludedDate       DateTime
  recurringBooking   RecurringBooking @relation(fields: [recurringBookingId], references: [id])

  @@unique([recurringBookingId, excludedDate])
  @@map("booking_exceptions")
}

model Payment {
  id           String            @id @default(uuid())
  bookingId    String
  amount       Float
  method       PaymentMethodType
  type         PaymentType
  status       PaymentStatus     @default(PENDIENTE)
  registeredBy String?
  createdAt    DateTime          @default(now())
  grossAmount  Float?
  mpFee        Float?            @default(0)
  platformFee  Float?            @default(0)
  netAmount    Float?
  paidAt       DateTime?         @db.Timestamp(6)
  notes        String?
  mpPaymentId  String?
  booking      Booking           @relation(fields: [bookingId], references: [id])
  register     User?             @relation("RegisteredBy", fields: [registeredBy], references: [id])

  @@map("payments")
}

model BarbershopPaymentMethod {
  id           String            @id @default(uuid())
  barbershopId String
  method       PaymentMethodType
  isActive     Boolean           @default(true)
  barbershop   Barbershop        @relation(fields: [barbershopId], references: [id])

  @@unique([barbershopId, method])
  @@map("barbershop_payment_methods")
}

model Offer {
  id            String       @id @default(uuid())
  barbershopId  String
  name          String
  description   String?
  discountType  DiscountType
  discountValue Float
  validFrom     DateTime
  validUntil    DateTime
  startTime     String?
  endTime       String?
  serviceIds    String[]     @default([])
  barberIds     String[]     @default([])
  appliesToAll  Boolean      @default(true)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  barbershop    Barbershop   @relation(fields: [barbershopId], references: [id])

  @@map("offers")
}

model Review {
  id           String     @id @default(uuid())
  userId       String
  barbershopId String
  barberId     String?
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barber       Barber?    @relation(fields: [barberId], references: [id])
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, barbershopId])
  @@map("reviews")
}

model Notification {
  id         String                  @id @default(uuid())
  title      String
  body       String
  createdAt  DateTime                @default(now())
  actionUrl  String?
  channels   String[]                @default([])
  entityId   String?
  entityType NotificationEntityType?
  expiresAt  DateTime?
  metadata   Json?
  priority   String                  @default("NORMAL")
  senderId   String?
  updatedAt  DateTime                @updatedAt
  type       NotificationType
  recipients NotificationUser[]
  sender     User?                   @relation("SentNotifications", fields: [senderId], references: [id])

  @@index([createdAt])
  @@map("notifications")
}

model NotificationUser {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  extraData      Json?
  deliveredAt    Json?
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notification_users")
}

model NotificationPreference {
  id       String           @id @default(uuid())
  userId   String
  type     NotificationType
  inApp    Boolean          @default(true)
  push     Boolean          @default(true)
  whatsapp Boolean          @default(true)
  email    Boolean          @default(false)
  user     User             @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("notification_preferences")
}

model PlatformConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("platform_config")
}

model BarbershopSubscription {
  id              String     @id @default(uuid())
  barbershopId    String     @unique
  plan            String
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  commissionRate  Float      @default(0.10)
  minDepositRate  Float      @default(0.30)
  mpPlanId        String?
  mpPreapprovalId String?
  nextBillingDate DateTime?
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id])

  @@map("barbershop_subscriptions")
}

model PlatformTransaction {
  id             String                 @id @default(uuid())
  barbershopId   String
  bookingId      String?
  bankAccountId  String?
  type           String
  grossAmount    Float
  platformFee    Float
  barbershopNet  Float?
  mpPaymentId    String?
  mpStatus       String?
  status         String                 @default("pending")
  transferStatus TransferStatus         @default(NOT_REQUIRED)
  transferredAt  DateTime?
  createdAt      DateTime               @default(now())
  barbershop     Barbershop             @relation(fields: [barbershopId], references: [id])
  booking        Booking?               @relation(fields: [bookingId], references: [id])
  bankAccount    BarbershopBankAccount? @relation(fields: [bankAccountId], references: [id])

  @@map("platform_transactions")
}

model RegistrationOrder {
  id        String    @id @default(uuid())
  code      String    @unique
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@map("registration_orders")
}

enum Role {
  ADMIN_GENERAL
  ADMIN_BARBERSHOP
  SUB_ADMIN
  USUARIO
}

enum BookingStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  NO_SHOW
}

enum PaymentType {
  SENA
  SALDO
}

enum PaymentMethodType {
  MERCADOPAGO
  EFECTIVO
  TRANSFERENCIA
  TARJETA_LOCAL
}

enum PaymentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
  DEUDA
}

enum BusinessModel {
  COMISION
  SUSCRIPCION
  GRATUITO
}

enum DepositType {
  FIXED
  PERCENTAGE
}

enum DayOfWeek {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum DiscountType {
  PORCENTAJE
  MONTO_FIJO
}

enum NotificationType {
  NOT_RESERVA_NUEVA
  NOT_RESERVA_CONFIRMADA
  NOT_RESERVA_CANCELADA
  NOT_RESERVA_RECORDATORIO_24H
  NOT_RESERVA_RECORDATORIO_1H
  NOT_RESERVA_COMPLETADA
  NOT_RESERVA_NO_SHOW
  NOT_PAGO_SENA
  NOT_PAGO_RECIBIDO
  NOT_OFERTA_NUEVA
  NOT_BIENVENIDA
  NOT_SISTEMA
}

enum NotificationEntityType {
  BOOKING
  BARBERSHOP
  PAYMENT
  OFFER
  USER
}

enum ImageType {
  ICONO
  PORTADA
  PERFIL
  GALERIA
}

enum BankAccountType {
  CBU
  CVU
  MP_OAUTH
}

enum BankAccountCategory {
  CAJA_AHORRO
  CUENTA_CORRIENTE
}

enum TransferStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
