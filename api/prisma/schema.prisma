generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum Role {
  ADMIN_GENERAL
  ADMIN_BARBERSHOP
  SUB_ADMIN
  USUARIO
}

enum BookingStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  NO_SHOW
}

enum PaymentType {
  SENA
  SALDO
}

enum PaymentMethodType {
  MERCADOPAGO
  EFECTIVO
  TRANSFERENCIA
  TARJETA_LOCAL
}

enum PaymentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

enum BusinessModel {
  COMISION
  SUSCRIPCION
  GRATUITO
}

enum DayOfWeek {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum DiscountType {
  PORCENTAJE
  MONTO_FIJO
}

enum NotificationType {
  NOT_RESERVA_NUEVA
  NOT_RESERVA_CONFIRMADA
  NOT_RESERVA_CANCELADA
  NOT_RESERVA_RECORDATORIO_24H
  NOT_RESERVA_RECORDATORIO_1H
  NOT_RESERVA_COMPLETADA
  NOT_RESERVA_NO_SHOW
  NOT_PAGO_SENA
  NOT_PAGO_RECIBIDO
  NOT_OFERTA_NUEVA
  NOT_BIENVENIDA
  NOT_SISTEMA
}

enum NotificationEntityType {
  BOOKING
  BARBERSHOP
  PAYMENT
  OFFER
  USER
}

// ==================== USERS ====================

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String?
  firstName  String
  lastName   String
  phone      String?
  address    String?
  avatarUrl  String?
  googleId   String?  @unique
  roles      Role[]   @default([USUARIO])
  isActive   Boolean  @default(true)
  pushTokens String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  barbershopAdmins          BarbershopAdmin[]
  barberProfiles            Barber[]
  bookings                  Booking[]
  cancelledBookings         Booking[]              @relation("BookingCancelledBy")
  reviews                   Review[]
  payments                  Payment[]              @relation("RegisteredBy")
  sentNotifications         Notification[]         @relation("SentNotifications")
  notificationRecipients    NotificationUser[]
  notificationPreferences   NotificationPreference[]
  refreshToken              String?

  @@map("users")
}

// ==================== IMAGES ====================

enum ImageType {
  ICONO
  PORTADA
  PERFIL
  GALERIA
}

model Image {
  id        String    @id @default(uuid())
  path      String
  url       String
  name      String?
  type      ImageType
  mimeType  String?
  size      Int?
  createdAt DateTime  @default(now())

  barbershopImages BarbershopImage[]
  barberImages     BarberImage[]

  @@map("images")
}

model BarbershopImage {
  id           String @id @default(uuid())
  barbershopId String
  imageId      String

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  image      Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([barbershopId, imageId])
  @@map("barbershop_images")
}

// ==================== BARBERSHOPS ====================

model Barbershop {
  id                String        @id @default(uuid())
  name              String        @unique
  slug              String        @unique @default("")
  description       String?
  address           String
  latitude          Float?
  longitude         Float?
  phone             String?
  depositAmount     Float         @default(0)
  cancellationHours Int           @default(12)
  minAdvanceHours   Int           @default(1)
  maxAdvanceDays    Int           @default(30)
  businessModel     BusinessModel @default(GRATUITO)
  maxBarbers        Int           @default(10)
  maxBarberImages   Int           @default(3)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  admins         BarbershopAdmin[]
  barbers        Barber[]
  images         BarbershopImage[]
  services       BarbershopService[]
  amenities      BarbershopAmenity[]
  paymentMethods BarbershopPaymentMethod[]
  reviews        Review[]
  offers         Offer[]
  subscription         BarbershopSubscription?
  platformTransactions PlatformTransaction[]

  @@map("barbershops")
}

model BarbershopAdmin {
  id           String @id @default(uuid())
  userId       String
  barbershopId String
  role         Role   @default(SUB_ADMIN)

  user       User       @relation(fields: [userId], references: [id])
  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, barbershopId])
  @@map("barbershop_admins")
}

// ==================== BARBERS ====================

model Barber {
  id           String  @id @default(uuid())
  barbershopId String
  userId       String?
  firstName    String
  lastName     String
  bio          String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershop   Barbershop     @relation(fields: [barbershopId], references: [id])
  user         User?          @relation(fields: [userId], references: [id])
  services     BarberService[]
  schedules    Schedule[]
  blockedSlots BlockedSlot[]
  bookings     Booking[]
  images       BarberImage[]
  reviews      Review[]

  @@map("barbers")
}

model BarberImage {
  id        String @id @default(uuid())
  barberId  String
  imageId   String
  sortOrder Int    @default(0)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  image  Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([barberId, imageId])
  @@map("barber_images")
}

// ==================== SERVICES (GLOBAL CATALOG) ====================

model Service {
  id             String  @id @default(uuid())
  name           String
  nameNormalized String  @unique
  description    String?
  category       String?
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  barbershops BarbershopService[]
  barbers     BarberService[]
  bookings    Booking[]

  @@map("services")
}

model BarbershopService {
  id           String @id @default(uuid())
  barbershopId String
  serviceId    String
  price        Float
  durationMin  Int
  isActive     Boolean @default(true)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  service    Service    @relation(fields: [serviceId], references: [id])

  @@unique([barbershopId, serviceId])
  @@map("barbershop_services")
}

model BarberService {
  id        String @id @default(uuid())
  barberId  String
  serviceId String
  price     Float?

  barber  Barber  @relation(fields: [barberId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([barberId, serviceId])
  @@map("barber_services")
}

// ==================== AMENITIES ====================

model Amenity {
  id        String  @id @default(uuid())
  name      String  @unique
  icon      String?
  category  String?
  isDefault Boolean @default(false)

  barbershops BarbershopAmenity[]

  @@map("amenities")
}

model BarbershopAmenity {
  id           String @id @default(uuid())
  barbershopId String
  amenityId    String

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  amenity    Amenity    @relation(fields: [amenityId], references: [id])

  @@unique([barbershopId, amenityId])
  @@map("barbershop_amenities")
}

// ==================== SCHEDULES ====================

model Schedule {
  id                  String    @id @default(uuid())
  barberId            String
  dayOfWeek           DayOfWeek
  openTime            String
  closeTime           String
  slotDurationMinutes Int       @default(30)

  barber Barber @relation(fields: [barberId], references: [id])

  @@unique([barberId, dayOfWeek])
  @@map("schedules")
}

model BlockedSlot {
  id        String   @id @default(uuid())
  barberId  String
  date      DateTime
  startTime String
  endTime   String
  reason    String?

  barber Barber @relation(fields: [barberId], references: [id])

  createdAt DateTime @default(now())

  @@map("blocked_slots")
}

// ==================== BOOKINGS ====================

model Booking {
  id           String        @id @default(uuid())
  userId       String
  barberId     String
  serviceId    String
  date         DateTime
  startTime    String
  endTime      String
  totalPrice   Float
  depositPrice Float         @default(0)
  status           BookingStatus @default(PENDIENTE)
  notes            String?
  mpPreferenceId   String?
  mpPaymentId      String?
  depositPaid      Boolean  @default(false)

  recurringBookingId String?
  cancelledById      String?

  user             User              @relation(fields: [userId], references: [id])
  barber           Barber            @relation(fields: [barberId], references: [id])
  service          Service           @relation(fields: [serviceId], references: [id])
  recurringBooking RecurringBooking? @relation(fields: [recurringBookingId], references: [id])
  cancelledBy      User?             @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  payments             Payment[]
  platformTransactions PlatformTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}

model RecurringBooking {
  id        String    @id @default(uuid())
  userId    String
  barberId  String
  serviceId String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  isActive  Boolean   @default(true)

  bookings   Booking[]
  exceptions BookingException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recurring_bookings")
}

model BookingException {
  id                 String   @id @default(uuid())
  recurringBookingId String
  excludedDate       DateTime

  recurringBooking RecurringBooking @relation(fields: [recurringBookingId], references: [id])

  @@unique([recurringBookingId, excludedDate])
  @@map("booking_exceptions")
}

// ==================== PAYMENTS ====================

model Payment {
  id           String            @id @default(uuid())
  bookingId    String
  amount       Float
  method       PaymentMethodType
  type         PaymentType
  status       PaymentStatus     @default(PENDIENTE)
  registeredBy String?

  booking  Booking @relation(fields: [bookingId], references: [id])
  register User?   @relation("RegisteredBy", fields: [registeredBy], references: [id])

  createdAt DateTime @default(now())

  @@map("payments")
}

model BarbershopPaymentMethod {
  id           String            @id @default(uuid())
  barbershopId String
  method       PaymentMethodType
  isActive     Boolean           @default(true)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  @@unique([barbershopId, method])
  @@map("barbershop_payment_methods")
}

// ==================== OFFERS ====================

model Offer {
  id            String       @id @default(uuid())
  barbershopId  String
  name          String
  description   String?
  discountType  DiscountType
  discountValue Float
  validFrom     DateTime
  validUntil    DateTime
  startTime     String?
  endTime       String?
  serviceIds    String[]     @default([])
  barberIds     String[]     @default([])
  appliesToAll  Boolean      @default(true)
  isActive      Boolean      @default(true)

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offers")
}

// ==================== REVIEWS ====================

model Review {
  id           String  @id @default(uuid())
  userId       String
  barbershopId String
  barberId     String?
  rating       Int
  comment      String?

  user       User       @relation(fields: [userId], references: [id])
  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  barber     Barber?    @relation(fields: [barberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, barbershopId])
  @@map("reviews")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id         String                  @id @default(uuid())
  senderId   String?
  title      String
  body       String
  type       NotificationType
  entityType NotificationEntityType?
  entityId   String?
  actionUrl  String?
  channels   String[]                @default([])
  priority   String                  @default("NORMAL")
  expiresAt  DateTime?
  metadata   Json?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  sender     User?              @relation("SentNotifications", fields: [senderId], references: [id])
  recipients NotificationUser[]

  @@index([createdAt])
  @@map("notifications")
}

model NotificationUser {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  extraData      Json?
  deliveredAt    Json?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notification_users")
}

model NotificationPreference {
  id       String           @id @default(uuid())
  userId   String
  type     NotificationType
  inApp    Boolean          @default(true)
  push     Boolean          @default(true)
  whatsapp Boolean          @default(true)
  email    Boolean          @default(false)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ==================== PLATFORM ====================

model PlatformConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("platform_config")
}

model BarbershopSubscription {
  id              String    @id @default(uuid())
  barbershopId    String    @unique
  plan            String    // GRATUITO | SUSCRIPCION | COMISION
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean   @default(true)

  // MercadoPago — modelo 2 (suscripción)
  mpPreapprovalId String?   // ID del preapproval en MP
  mpPlanId        String?   // ID del plan en MP (reutilizable)
  nextBillingDate DateTime?

  // Modelo 3 (comisión)
  commissionRate  Float     @default(0.10)  // % que cobra la plataforma
  minDepositRate  Float     @default(0.30)  // % mínimo del precio como depósito

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("barbershop_subscriptions")
}

model PlatformTransaction {
  id             String   @id @default(uuid())
  barbershopId   String
  bookingId      String?
  type           String   // subscription | commission
  grossAmount    Float
  platformFee    Float
  barbershopNet  Float?
  mpPaymentId    String?
  mpStatus       String?  // approved | pending | rejected
  status         String   @default("pending") // pending | confirmed | transferred | failed
  createdAt      DateTime @default(now())

  barbershop Barbershop @relation(fields: [barbershopId], references: [id])
  booking    Booking?   @relation(fields: [bookingId], references: [id])

  @@map("platform_transactions")
}

model RegistrationOrder {
  id        String   @id @default(uuid())
  code      String   @unique
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("registration_orders")
}
